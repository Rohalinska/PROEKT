@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @* Вказуємо на MainLayout всередині твоєї папки Layout *@
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(SportsLeagueWeb.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(SportsLeagueWeb.Layout.MainLayout)">
            <p role="alert">Сторінку не знайдено.</p>
        </LayoutView>
    </NotFound>
</Router>